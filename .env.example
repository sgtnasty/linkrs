# Copy this file to .env and fill in values to pin the bootstrap admin
# account's credentials. Only read once, the first time the server starts
# with an empty `users` table — changing these later has no effect on an
# already-created account.
#
# If LINKRS_ADMIN_PASSWORD is left unset, a random password is generated and
# printed to the console on first run instead.

LINKRS_ADMIN_USER=admin
LINKRS_ADMIN_PASSWORD=change-me
